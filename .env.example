# VAI IA — environment template (placeholders only; NEVER commit real secrets).
# Copy to .env.staging / .env and fill with real values. Real env files are
# git-ignored.

# ── Core ──
APP_ENV=staging
NODE_ENV=production
PORT=3100

# ── Supabase (use the STAGING project ref for staging; never production) ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Auth ──
JWT_SECRET=generate-a-random-64-char-string
ADMIN_TOKEN=generate-a-random-32-char-string
# COOKIE_SECURE=1   # set only when serving over HTTPS

# ── AI ──
GROQ_API_KEY=your-groq-api-key
# BUSINESS_ASSISTANT_GROQ_MODEL=llama-3.3-70b-versatile

# ── Business Assistant storage ──
BUSINESS_ASSISTANT_ALLOW_FILE_STORAGE=false

# ── Integration secrets vault ──
# 32-byte master key for AES-256-GCM encryption of integration secrets
# (e.g. Twilio Auth Token). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must live ONLY in the environment — never in the database or git.
INTEGRATIONS_ENCRYPTION_KEY=your-32-byte-hex-or-base64-key

# ── Twilio (optional; managed per-tenant via Admin → Apps → Twilio) ──
# TWILIO_ENABLED=true|false
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ── SMTP (optional; booking confirmation e-mails) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
